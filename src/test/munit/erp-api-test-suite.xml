<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="erp-api-test-suite.xml"/>

    <!-- Fake Odoo: answers each JSON-2 call based on the model and method the flow is calling -->
    <sub-flow name="mock-odoo">
        <munit-tools:mock-when processor="http:request">
            <munit-tools:with-attributes>
                <munit-tools:with-attribute attributeName="config-ref" whereValue="Odoo_API"/>
            </munit-tools:with-attributes>
            <munit-tools:then-return>
                <munit-tools:payload mediaType="application/json" value="#[output application/json ---
                    if (vars.odooModel == 'sale.order' and vars.odooMethod == 'search_read') (vars.fakeExistingOrders default [])
                    else if (vars.odooModel == 'res.partner') (vars.fakePartners default [{ id: 7, name: 'Cobalt Fabrication Ltd', credit_limit: 25000, credit: 0 }])
                    else if (vars.odooModel == 'product.product') [{ id: 11, default_code: 'BLT-3001' }]
                    else if (vars.odooMethod == 'create') [42]
                    else if (vars.odooMethod == 'action_confirm') true
                    else [{ name: 'S00042', state: 'sale', amount_total: 44 }]]"/>
            </munit-tools:then-return>
        </munit-tools:mock-when>
    </sub-flow>

    <munit:test name="submit-creates-and-confirms-odoo-order" description="A new Salesforce order becomes a confirmed Odoo sales order">
        <munit:behavior>
            <flow-ref name="mock-odoo"/>
            <munit:set-event>
                <munit:payload mediaType="application/json" value='#[output application/json --- { orderNumber: "TEST", poNumber: "TEST-PO", accountNumber: "CUST-1002", lines: [ { sku: "BLT-3001", quantity: 2, unitPrice: 22 } ] }]'/>
                <munit:attributes value="#[{ headers: { 'x-api-key': 'munit-api-key' }, uriParams: { orderId: 'ORD-1' } }]"/>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="erp-submit-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.error]" is="#[MunitTools::nullValue()]"/>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('Confirmed')]"/>
            <munit-tools:assert-that expression="#[payload.erpOrderNumber]" is="#[MunitTools::equalTo('S00042')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="submit-returns-existing-order" description="A resubmit returns the existing Odoo order instead of creating a duplicate">
        <munit:behavior>
            <set-variable variableName="fakeExistingOrders" value="#[[{ id: 42, name: 'S00042', state: 'sale' }]]"/>
            <flow-ref name="mock-odoo"/>
            <munit:set-event>
                <munit:payload mediaType="application/json" value='#[output application/json --- { accountNumber: "CUST-1002", lines: [ { sku: "BLT-3001", quantity: 2, unitPrice: 22 } ] }]'/>
                <munit:attributes value="#[{ headers: { 'x-api-key': 'munit-api-key' }, uriParams: { orderId: 'ORD-1' } }]"/>
                <munit:variables>
                    <munit:variable key="fakeExistingOrders" value="#[[{ id: 42, name: 'S00042', state: 'sale' }]]"/>
                </munit:variables>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="erp-submit-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.erpOrderNumber]" is="#[MunitTools::equalTo('S00042')]"/>
            <munit-tools:verify-call processor="http:request" times="1"/>
        </munit:validation>
    </munit:test>

    <munit:test name="submit-rejects-over-credit-limit" description="Orders above the Odoo credit limit come back as Failed with the reason">
        <munit:behavior>
            <flow-ref name="mock-odoo"/>
            <munit:set-event>
                <munit:payload mediaType="application/json" value='#[output application/json --- { accountNumber: "CUST-1003", lines: [ { sku: "PMP-6001", quantity: 80, unitPrice: 449 } ] }]'/>
                <munit:attributes value="#[{ headers: { 'x-api-key': 'munit-api-key' }, uriParams: { orderId: 'ORD-2' } }]"/>
                <munit:variables>
                    <munit:variable key="fakePartners" value="#[[{ id: 9, name: 'Harbor and Pine Facilities', credit_limit: 25000, credit: 0 }]]"/>
                </munit:variables>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="erp-submit-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('Failed')]"/>
            <munit-tools:assert-that expression="#[payload.error contains 'Credit limit exceeded']" is="#[MunitTools::equalTo(true)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="submit-requires-api-key" description="Calls without the shared secret are refused" expectedErrorType="APP:UNAUTHORIZED">
        <munit:behavior>
            <munit:set-event>
                <munit:payload value="#[{}]"/>
                <munit:attributes value="#[{ headers: { 'x-api-key': 'wrong' }, uriParams: { orderId: 'ORD-3' } }]"/>
            </munit:set-event>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="erp-submit-api"/>
        </munit:execution>
    </munit:test>
</mule>
